        "def limpar_texto_bruto(serie):\n",
        "    \"\"\"Nulo vira string vazia; quebras de linha/tabs e espaços repetidos viram um espaço só.\"\"\"\n",
        "    return (serie.fillna(\"\").astype(str)\n",
