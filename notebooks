        "# Lista de stopwords em português (definida localmente — evita dependência de download externo,\n",
        "# robusto para rodar tanto aqui quanto no Google Colab sem precisar de nltk.download)\n",
        "STOPWORDS_PT = set('''\n",
        "a ao aos aquela aquelas aquele aqueles aquilo as até com como da das de dela\n",
        "delas dele deles depois do dos e ela elas ele eles em entre era eram essa\n",
        "essas esse esses esta estas este estes eu foi fomos for foram fosse fui\n",
        "há isso isto já lhe lhes mais mas me mesmo meu meus minha minhas muito na\n",
        "nas nem no nos nossa nossas nosso nossos num numa não nós o os ou para\n",
        "pela pelas pelo pelos por qual quando que quem se seu seus só sua suas\n",
        "também te tem tendo tenho ter teu teus teve tinha tive to toda todas todo\n",
        "todos tu tua tuas um uma você vocês vos à às é ja pra pro pq tb ta tava\n",
        "'''.split())\n",
        "\n",
        "def normalizar_para_nlp(texto):\n",
        "    if pd.isna(texto):\n",
        "        return \"\"\n",
        "    texto = str(texto).lower()\n",
        "    texto = unicodedata.normalize('NFKD', texto).encode('ascii', 'ignore').decode('utf-8')\n",
        "    texto = re.sub(r'[^a-z0-9\\s]', ' ', texto)\n",
        "    texto = re.sub(r'\\s+', ' ', texto).strip()\n",
        "    return texto\n",
        "\n",
        "def tokenizar_sem_stopwords(texto_limpo):\n",
        "    tokens = texto_limpo.split()\n",
        "    return [t for t in tokens if t not in STOPWORDS_PT and len(t) > 2]\n",
        "\n",
        "rag['texto_limpo_nlp'] = rag['texto'].apply(normalizar_para_nlp)\n",
        "rag['tokens'] = rag['texto_limpo_nlp'].apply(tokenizar_sem_stopwords)\n",
        "rag['n_tokens'] = rag['tokens'].apply(len)\n",
        "\n",
        "vazio_pos_limpeza = (rag['n_tokens'] == 0).sum()\n",
